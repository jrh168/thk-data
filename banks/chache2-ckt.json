":[{"key":"A","text":"空气，氧气"},{"key":"B","text":"汽油、柴油"},{"key":"C","text":"石蜡、樟脑"}],"answer":"A"},{"type":"判断题","stem":"到期未检验的特种设备，必须停止使用。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"停车前应（），并以方向灯示意后方来车及附近人员注意","options":[],"answer":""},{"type":"判断题","stem":"特种设备出现故障或者发生异常情况，特种设备维保单位应当对其进行全面检查消除事故隐患，方可继续使用。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"疲劳驾驶是叉车事故直接原因。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"判断题","stem":"叉车日常保养项目规定，行车前要检查各仪表、照明和音响信号工作情况。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"特种设备使用安全的责任主体是（）。","options":[],"answer":""},{"type":"多选题","stem":"叉车起升系统常见故障包括（）","options":[{"key":"A","text":"起升无力"},{"key":"B","text":"起升后自行下降"},{"key":"C","text":"门架倾斜"},{"key":"D","text":"链条断裂"}],"answer":"ABCD"},{"type":"判断题","stem":"叉车液压油可以把不同品种和牌号的液压油混用（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"多选题","stem":"特种设备生产、经营、使用单位有下列哪些情形之一的，责令限期改正；逾期未改正的，责令停止使用有关特种设备或者停产停业整顿，处一万元以上五万元以下罚款（）","options":[{"key":"A","text":"未配备具有相应资格的特种设备安全管理人员、检测人员和作业人员的"},{"key":"B","text":"使用未取得相应资格的人员从事特种设备安全管理、检测和作业的"},{"key":"C","text":"未对特种设备安全管理人员、检测人员和作业人员进行安全教育和技能培训的"},{"key":"D","text":"使用未取得许可生产，未经检验或者检验不合格的特种设备的"}],"answer":"ABC"},{"type":"判断题","stem":"《特种设备作业人员监督管理办法》规定申请《特种设备作业人员证》的人员应当符合年龄在18周岁以上。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"未经定期检验或者检验不合格的特种设备，只要未曾发生事故就可以继续使用。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"多选题","stem":"对于提供（）造成事故的，由发证机关记入特种设备作业人员发证档案。","options":[{"key":"A","text":"虚假材料及承诺"},{"key":"B","text":"考试作弊"},{"key":"C","text":"违反操作规程"},{"key":"D","text":"遵守有关安全规章制度"}],"answer":"ABC"},{"type":"单选题","stem":"个别继电器经常烧毁，其原因一般是该继电器：（）","options":[{"key":"A","text":"价格低"},{"key":"B","text":"质量不好"},{"key":"C","text":"离风扇太近"},{"key":"D","text":"离发动机太近"}],"answer":"D"},{"type":"多选题","stem":"市场监督管理部门发现（）或者特种设备存在（），应当责令被检查单位立即停止违法行为、采取措施消除事故隐患","options":[],"answer":""},{"type":"多选题","stem":"《特种设备安全监察条例》规定：与事故相关的单位和人员不得迟报、谎报或者瞒报事故情况，不得（）。","options":[{"key":"A","text":"隐匿有关证据"},{"key":"B","text":"毁灭有关证据"},{"key":"C","text":"故意破坏事故现场"},{"key":"D","text":"保护事故现场"}],"answer":"ABC"},{"type":"单选题","stem":"特种设备作业人员各科目考试成绩均实行百分制，单科合格分数线为（）","options":[{"key":"A","text":"60"},{"key":"B","text":"70"},{"key":"C","text":"80"},{"key":"D","text":"90"}],"answer":"B"},{"type":"多选题","stem":"特种设备安全工作应当坚持的原则包括：()。","options":[{"key":"A","text":"安全第一"},{"key":"B","text":"预防为主"},{"key":"C","text":"节能环保"},{"key":"D","text":"综合治理"}],"answer":"ABCD"},{"type":"单选题","stem":"车辆拆装螺栓、螺母需要用尺寸规格一致的专用（）。","options":[],"answer":""},{"type":"判断题","stem":"《特种设备作业人员监督管理办法》规定申请《特种设备作业人员证》的人员应当符合年龄在 18 周岁以上。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"在车库及作业场所必须设有明显的安全标志及消防器材。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"紧急情况需进行紧急制动外，一般的制动必须（）。","options":[],"answer":""},{"type":"单选题","stem":"（）设备应报废，并向原登记机关注销。","options":[{"key":"A","text":"存在严重事故隐患、无改造、维修价值的"},{"key":"B","text":"超过检验周期的"},{"key":"C","text":"发生过一般事故的"},{"key":"D","text":"管理混乱的"}],"answer":"A"},{"type":"判断题","stem":"《中华人民共和国特种设备安全法》规定，特种设备使用单位应当对特种设备作业人员进行必要的安全教育和技能培训。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"叉车传动轴主要由轴管、伸缩套和万向节组成","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"叉车操作过程中，严禁驾驶员有下列哪些行为（）","options":[{"key":"A","text":"饮食"},{"key":"B","text":"闲谈"},{"key":"C","text":"打手机"},{"key":"D","text":"用对讲机讲话"}],"answer":"ABCD"},{"type":"单选题","stem":"《特种设备作业人员监督管理办法》规定，申请《特种设备作业人员证》的人员，应当首先向发证部门指定的特种设备作业人员（）机构报名参加考试。","options":[{"key":"A","text":"培训"},{"key":"B","text":"考试"},{"key":"C","text":"审查"},{"key":"D","text":"考核"}],"answer":"A"},{"type":"单选题","stem":"酸性蓄电池正极板是活性物质二氧化铅，负极板是（）。","options":[],"answer":""},{"type":"单选题","stem":"转向装置的作用是使驾驶员能方便、可靠的操纵车辆，按（）的方向行驶","options":[{"key":"A","text":"前进"},{"key":"B","text":"后退"},{"key":"C","text":"规定"},{"key":"D","text":"需要"}],"answer":"D"},{"type":"单选题","stem":"特种设备安全技术规范由（）负责特种设备安全监督管理的部门制定。","options":[],"answer":""},{"type":"多选题","stem":"《特种设备安全监察条例》所称特种设备是指涉及生命安全、危险性较大的锅炉、压力容器（含气瓶）、压力管道、（）、客运索道、大型游乐设施","options":[],"answer":""},{"type":"判断题","stem":"《特种设备安全监察条例》规定，任何单位和个人对违反本条例规定的行为，有权向特种设备安全监督管理部门和行政监察等有关部门举报。特种设备安全监督管理部门和行政监察等有关部门应当对举报人给予公开奖励。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"车辆会车时，有障碍的一方车应先行。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"多选题","stem":"车辆技术状况的好坏对安全行车起着重要的作用，其中（）技术状况的影响最大","options":[{"key":"A","text":"动力系统"},{"key":"B","text":"转向系统"},{"key":"C","text":"燃油系统"},{"key":"D","text":"制动系统"}],"answer":"BD"},{"type":"多选题","stem":"《特种设备安全法》的立法目的包括（）","options":[{"key":"A","text":"加强特种设备安全工作"},{"key":"B","text":"预防特种设备事故"},{"key":"C","text":"保障人身和财产安全"},{"key":"D","text":"促进经济社会发展"}],"answer":"ABCD"},{"type":"单选题","stem":"特种设备安装、改造及重大维修的告知形式中，不正确的形式有（）。","options":[],"answer":""},{"type":"单选题","stem":"车辆装载超重，会使车辆的制动距离（）。","options":[{"key":"A","text":"不变"},{"key":"B","text":"缩短"},{"key":"C","text":"加长"},{"key":"D","text":"正常"}],"answer":"C"},{"type":"判断题","stem":"叉车日常保养项目规定，行车前要检查发动机有无异响，工作是否正常。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"易燃、易爆物品的生产区域或贮存仓库区，应根据安全生产的需要，将道路划分为（）车辆通行或（）车辆通行的路段，并设置标志。","options":[{"key":"A","text":"可以"},{"key":"B","text":"限制"},{"key":"C","text":"不准"},{"key":"D","text":"禁止"}],"answer":"BD"},{"type":"单选题","stem":"主减速器起着（）的作用","options":[{"key":"A","text":"变换车速"},{"key":"B","text":"降低转速、增大输出扭矩和改变传动旋转方向"},{"key":"C","text":"连接和传递两根轴线不相重合的动力"},{"key":"D","text":"切断动力"}],"answer":"B"},{"type":"单选题","stem":"一般机动车辆的电气设备由（）两部分组成。","options":[{"key":"A","text":"供电设备和用电设备"},{"key":"B","text":"蓄电池和灯光"},{"key":"C","text":"蓄电池和仪表"}],"answer":"A"},{"type":"多选题","stem":"特种设备安全监督部门应当建立特种设备安全监察举报制度，为了方便举报应将（）公布。","options":[{"key":"A","text":"举报电话"},{"key":"B","text":"电子邮件地址"},{"key":"C","text":"信箱"},{"key":"D","text":"办公地址"}],"answer":"ABCD"},{"type":"判断题","stem":"平交路口即是“意志决定点”，也是可能发生冲突的冲突点。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"《工业企业厂内铁路、道路运输安全规程》规定：路面狭窄或交通量大、容易堵塞的道路，应尽量实行（）","options":[{"key":"A","text":"双向通行"},{"key":"B","text":"单向通行"},{"key":"C","text":"禁止通行"},{"key":"D","text":"限速通行"}],"answer":"B"},{"type":"判断题","stem":"特种设备使用单位应当使用取得许可生产并经检验的特种设备","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"重大事故隐患与重大危险源是引发重大事故的源头，所以两者的概念是等同的。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"特种设备存在严重事故隐患，无改造、维修价值的特种设备，使用单位应当及时予以报废，不需要办理注销手续。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"单选题","stem":"车辆在高速行驶的条件下制动距离会延长，扩大了制动非安全区。据测定，驾驶员的反应时间与制动器起作用时间的车速（）。","options":[{"key":"A","text":"成正比"},{"key":"B","text":"成反比"},{"key":"C","text":"无关系"}],"answer":"A"},{"type":"判断题","stem":"没有滤布时可以用丝绸和毛毯等物过滤油料。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"《特种设备安全监察条例》规定，特种设备生产、使用单位的主要负责人应当对本单位特种设备的安全和节能全面负责。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"《工业企业厂内铁路、道路运输安全规程》规定：机动车牵引挂车，应符合下列要求：..c）机动车在（）情况下，不得拖带载重挂车；d）每辆机动车只牵引（）辆挂车。","options":[{"key":"A","text":"载重，2"},{"key":"B","text":"空载，1"},{"key":"C","text":"空载，2"},{"key":"D","text":"载重，1"}],"answer":"B"},{"type":"单选题","stem":"车辆在高速行驶的条件下制动距离会延长，扩大了制动非安全区。据测定，驾驶员的反应时间通常为（）秒左右","options":[{"key":"A","text":"0.3-0.5"},{"key":"B","text":"0.6-0.8"},{"key":"C","text":"1.0-1.2"},{"key":"D","text":"1.5-2.0"}],"answer":"B"},{"type":"单选题","stem":"驾驶中的判断，是处理已观察到的信息和进行（）决定的过程","options":[{"key":"A","text":"经验"},{"key":"B","text":"意志"},{"key":"C","text":"习惯"},{"key":"D","text":"流程"}],"answer":"B"},{"type":"单选题","stem":"《特种设备作业人员监督管理办法》规定，相关作业人员应积极参加特种设备安全教育和（）培训。","options":[{"key":"A","text":"安全管理人员"},{"key":"B","text":"操作技术"},{"key":"C","text":"安全技术"},{"key":"D","text":"应急疏散"}],"answer":"C"},{"type":"单选题","stem":"在“三检”中，检查发动机的油面高度应在机油尺刻度标准的（）之间。","options":[],"answer":""},{"type":"单选题","stem":"特种设备作业人员在作业过程中发现事故隐患或其它不安全因素，应当（）向现场安全管理人员和单位有关负责人报告。","options":[{"key":"A","text":"自行处理后"},{"key":"B","text":"立即"},{"key":"C","text":"完成工作任务后"},{"key":"D","text":"停止作业后"}],"answer":"B"},{"type":"单选题","stem":"脚踏制动踏板到制动开始的反应时间，室内模拟实验为（）s左右。","options":[{"key":"A","text":"0.3"},{"key":"B","text":"0.4"},{"key":"C","text":"0.5"},{"key":"D","text":"0.6"}],"answer":"C"},{"type":"多选题","stem":"下列属于特种设备事故应急处置措施的是（）","options":[{"key":"A","text":"立即停止使用特种设备"},{"key":"B","text":"组织抢救受伤人员"},{"key":"C","text":"防止事故扩大"},{"key":"D","text":"报告特种设备安全监督管理部门"}],"answer":"ABCD"},{"type":"判断题","stem":"燃油表用来指示车辆燃油箱内储存燃油量的多少。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"根据《特种设备作业人员监督管理办法》，申请《特种设备作业人员证》的具体条件应当按照（）的规定执行。","options":[{"key":"A","text":"考核规则"},{"key":"B","text":"考试大纲"},{"key":"C","text":"安全监察规程"},{"key":"D","text":"相关安全技术规范"}],"answer":"D"},{"type":"判断题","stem":"《中华人民共和国特种设备安全法》的制定是：为了加强特种设备安全工作，预防特种设备事故，保障人身和财产安全，促进经济社会发展。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"TSG81—2022《场（厂）内专用机动车辆安全技术规程》自2022年12月1日起施行。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"下列哪种叉车起升链条对驾驶员视线较为有利。()","options":[{"key":"A","text":"单排"},{"key":"B","text":"双排"}],"answer":"A"},{"type":"判断题","stem":"电瓶电解液含有硫酸，若与之接触可能造成烧伤，如发生意外，请立即用水冲洗 10-15 分钟或进行急救并请医生治理。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"万向节的作用是在两轴之间夹角不断变化情况下可靠传递转矩。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"车辆会车时，有障碍一方先行。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"TSG81－2022《场（厂）内专用机动车辆安全技术规程》规定。对维护保养和检查中发现的异常情况应当及时处理，消除事故隐患，并且记录，记录存入安全技术档案；维护保养、定期自行检查记录至少保存（）年。","options":[{"key":"A","text":"2"},{"key":"B","text":"3"},{"key":"C","text":"4"},{"key":"D","text":"5"}],"answer":"D"},{"type":"单选题","stem":"电气设备、线路等着火时，可用（）扑救","options":[],"answer":""},{"type":"单选题","stem":"特种设备作业人员涂改、出租、出借《特种设备作业人员证》的，处（）元以下罚款；构成犯罪的，依法追究刑事责任。","options":[],"answer":""},{"type":"判断题","stem":"叉车作业人员有义务经常保持蓄电池外部及接线处的清洁，经常检查蓄电池外壳有无裂纹和有无电解液渗出。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"内燃叉车传动分机械、动液两种。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"在车辆行驶中，驾驶员由眼睛等感觉器官获得信息，传入大脑，经过大脑处理后发生命令而产生动作，这一段时间称为（）。","options":[],"answer":""},{"type":"判断题","stem":"TSG81-2022《场（厂）内专用机动车辆安全技术规程》适用于场车在《中华人民共和国道路交通安全法》所规定道路上行驶的情形。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"按《特种设备安全监察条例》规定，特种设备事故造成3人以上10人以下死亡，属于重大事故。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"叉车的型号表示方法中，动力类型代号 “D” 表示（）","options":[{"key":"A","text":"柴油"},{"key":"B","text":"汽油"},{"key":"C","text":"石油气"},{"key":"D","text":"蓄电池"}],"answer":"A"},{"type":"判断题","stem":"职业道德：就是人们在进行职业活动过程中，一切符合职业要求的心理意识、行为准则和行为规范的总和。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"特种设备（）单位应当建立特种设备安全技术档案。","options":[{"key":"A","text":"经营"},{"key":"B","text":"生产"},{"key":"C","text":"使用"},{"key":"D","text":"设计"}],"answer":"C"},{"type":"单选题","stem":"起动机的作用是将（）转换为机械能以起动发动机工作。","options":[],"answer":""},{"type":"单选题","stem":"驾驶员在实践中，要运用心理学对行车路上各种信息进行分析、综合、判断、推理、处置，保证（）安全","options":[{"key":"A","text":"学习"},{"key":"B","text":"实习"},{"key":"C","text":"行车"},{"key":"D","text":"修理"}],"answer":"C"},{"type":"判断题","stem":"为了加强特种设备安全工作，预防特种设备事故，保障人身和财产安全，促进经济社会发展，制定《特种设备安全法》。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"在新车投入使用之前，要（）","options":[{"key":"A","text":"组织驾驶员和维修工进行培训"},{"key":"B","text":"核对班次、安排好生产"},{"key":"C","text":"把驾驶室打扫干净，贴好遮阳膜"},{"key":"D","text":"更换全部油液"}],"answer":"A"},{"type":"判断题","stem":"钢板弹簧、减震器可避免汽车的剧烈震动、颠簸和冲击。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"下列属于实心胎优点的是（）","options":[{"key":"A","text":"耐磨性"},{"key":"B","text":"耐刺扎性"},{"key":"C","text":"安全性"},{"key":"D","text":"耐久性"}],"answer":"ABCD"},{"type":"判断题","stem":"转向系统是指用于改变或控制车辆行驶方向的机构。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"TSGZ6001-2019《特种设备作业人员考核规则》对特种设备作业人员年龄的上限作出规定（）。","options":[{"key":"A","text":"男女都不超过 55 岁"},{"key":"B","text":"男女都不超过 60 岁"},{"key":"C","text":"男女都不超过 50 岁"},{"key":"D","text":"男年龄不超过 60 岁，女不超过 55 岁"}],"answer":"B"},{"type":"单选题","stem":"关于导体下面说法错误的是（）","options":[{"key":"A","text":"容易让电流通过的物体"},{"key":"B","text":"比如钢、铁都是导体"},{"key":"C","text":"电阻率小于十的负八次方欧姆平方毫米每米"},{"key":"D","text":"电阻为零"}],"answer":"D"},{"type":"多选题","stem":"液压系统安全要求包括（）。","options":[{"key":"A","text":"管路接头牢靠、无渗漏"},{"key":"B","text":"传动部件在额定载荷和转速范围内不出现爬行、停滞和明显冲击"},{"key":"C","text":"多路换向阀壳体无裂纹、渗漏，工作性能良好可靠"},{"key":"D","text":"载荷曲线、液压系统铭牌齐全清晰"}],"answer":"ABCD"},{"type":"单选题","stem":"特种设备使用单位对在用特种设备应当至少（）进行一次自行检查，并作出记录。","options":[{"key":"A","text":"6个月"},{"key":"B","text":"12个月"},{"key":"C","text":"每月"},{"key":"D","text":"3个月"}],"answer":"C"},{"type":"多选题","stem":"国务院《特种设备安全监察条例》规定，特种设备的生产环节包括（）。","options":[],"answer":""},{"type":"单选题","stem":"驾驶员要坚持“三检”，即（）的检查。","options":[],"answer":""},{"type":"单选题","stem":"下面（）是制动系的功用。","options":[],"answer":""},{"type":"单选题","stem":"《中华人民共和国特种设备安全法》规定，特种设备安全管理人员、检测人员和作业人员不履行岗位职责，违反操作规程和有关安全规章制度，（），吊销相关人员的资格。","options":[{"key":"A","text":"造成后果的"},{"key":"B","text":"造成事故的"},{"key":"C","text":"造成不良影响的"},{"key":"D","text":"AB"},{"key":"E","text":"均是"}],"answer":"B"},{"type":"单选题","stem":"起步时，松（）与踏加速踏板的动作要配合适当。","options":[],"answer":""},{"type":"多选题","stem":"发动机润滑系的基本功用包括（）。","options":[],"answer":""},{"type":"单选题","stem":"下列哪种叉车起升链条对驾驶员视线较为有利（）","options":[{"key":"A","text":"单排"},{"key":"B","text":"双排"},{"key":"C","text":"三排"},{"key":"D","text":"四排"}],"answer":"A"},{"type":"单选题","stem":"道路交通标志中的警告标志形状为（）。","options":[],"answer":""},{"type":"判断题","stem":"车速过快对人、车辆不会带来不利影响（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"左右轮胎充气压力不一致会导致（）","options":[{"key":"A","text":"方向摆头"},{"key":"B","text":"转向跑偏"},{"key":"C","text":"转向沉重"},{"key":"D","text":"制动失灵"}],"answer":"B"},{"type":"单选题","stem":"结冰、积雪、积水的道路，叉车的最高行驶速度为（）公里/小时","options":[],"answer":""},{"type":"多选题","stem":"《中华人民共和国特种设备安全法》制定的目的是为了（）。","options":[],"answer":""},{"type":"单选题","stem":"视线盲区是指驾驶员行驶中受视线影响，观察不到的视线（）区域","options":[{"key":"A","text":"范围"},{"key":"B","text":"角度"},{"key":"C","text":"死角"},{"key":"D","text":"距离"}],"answer":"C"},{"type":"单选题","stem":"特种设备出现（）情况时，特种设备使用单位可以不予报废，经检验合格后继续使用。","options":[],"answer":""},{"type":"单选题","stem":"叉车的工作装置由（）两部分组成","options":[],"answer":""},{"type":"判断题","stem":"一物体不论在什么地方，不论放置方位怎样变化，其重心位置是不变的。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"冬季使用的机油应选用粘度小的机油，而夏季应选用粘度大的机油。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"叉车在出现油管或油缸漏油故障时，应立即停车，禁止工作","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"下列哪一种情况不得参加《特种设备作业人员证》复审申请？","options":[],"answer":""},{"type":"单选题","stem":"遇险情时要（）","options":[{"key":"A","text":"先顾物后顾人"},{"key":"B","text":"就轻避重"},{"key":"C","text":"优先保护设备"},{"key":"D","text":"快速逃离"}],"answer":"B"},{"type":"多选题","stem":"违反《特种设备安全法》规定，特种设备生产、经营、使用单位有下列情形之一的，责令限期改正，逾期未改正的，责令停止使用有关特种设备或者停产停业整顿，处一万元以上五万元以下罚款。","options":[{"key":"A","text":"明知特种设备存在同一性缺陷，未立即停止生产并召回的"},{"key":"B","text":"未配备具有相应资格的特种设备安全管理人员、检测人员和作业人员的"},{"key":"C","text":"使用未取得相应资格的人员从事特种设备安全管理、检测和作业的"},{"key":"D","text":"未对特种设备安全管理人员、检测人员进行安全教育和技能培训的"}],"answer":"BCD"},{"type":"单选题","stem":"在平交路有视野盲区的情况下，车辆行至路口鸣喇叭的时间可长一些，以提醒横向来的车辆或行人引起注意。驾驶员的反应时间与制动器起作用的时间（）","options":[{"key":"A","text":"成正比"},{"key":"B","text":"成反比"},{"key":"C","text":"无关系"}],"answer":"C"},{"type":"判断题","stem":"场车定期检验资料保存 5 年。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"饮酒后，随着浓度的增高对驾驶机能影响会降低，发生事故的比例也会随之增高。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"按国务院《特种设备安全监察条例》规定，国家强制推行科学的管理方法，采用先进技术，提高特种设备安全性能和管理水平，增强特种设备生产、使用单位防范事故的能力。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"遇险时要先顾方向后顾制动。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"车用机油压力表用于指示发动机润滑系主油道中机油压力的大小。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"《特种设备安全监察条例》规定，特种设备安全监督管理部门对特种设备生产、使用单位和检验检测机构进行安全监察，发现重大违法行为或严重事故隐患，应当在采取必要措施的同时，及时向（）报告。","options":[{"key":"A","text":"上级特种设备安全监督管理部门"},{"key":"B","text":"当地政府"},{"key":"C","text":"当地特种设备安全监督管理部门"},{"key":"D","text":"特种设备使用单位"}],"answer":"B"},{"type":"单选题","stem":"挂档或换档时，应一手握稳方向盘，放松油门踏板，踏下（）踏板。","options":[{"key":"A","text":"离合器"},{"key":"B","text":"转向器"},{"key":"C","text":"制动器"},{"key":"D","text":"转向离合器"}],"answer":"A"},{"type":"判断题","stem":"特种设备使用单位应当使用取得许可生产并经检验合格的特种设备。禁止使用国家明令淘汰和已经报废的特种设备。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"倒车事故的预防：车辆在企业内平交路上，()、()等危险地段不准倒车。","options":[{"key":"A","text":"主道路"},{"key":"B","text":"桥梁"},{"key":"C","text":"陡坡"},{"key":"D","text":"车间"}],"answer":"BC"},{"type":"单选题","stem":"《特种设备作业人员考核规则》TSGZ6001-2019规定，发证机关应当在收到考试结果后的（）个工作日内完成审批发证工作。","options":[],"answer":""},{"type":"单选题","stem":"任何单位和个人有权向负责特种设备安全（）的部门和有关部门举报涉及特种设备安全的违法行为。","options":[{"key":"A","text":"检验"},{"key":"B","text":"检测"},{"key":"C","text":"技术管理"},{"key":"D","text":"监督管理"}],"answer":"D"},{"type":"多选题","stem":"《特种设备安全法》规定，特种设备发生事故后，事故发生单位应当按照应急预案采取措施，(),保护事故现场和有关证据，并及时向事故发生地县级以上人民政府负责特种设备安全监督管理的部门报告。","options":[{"key":"A","text":"防止事故扩大"},{"key":"B","text":"组织抢救"},{"key":"C","text":"减少人员伤亡和财产损失"}],"answer":"ABC"},{"type":"单选题","stem":"汽油的易燃液体级别为（）。","options":[],"answer":""},{"type":"单选题","stem":"燃油滤清器堵塞的处理方法是（）。","options":[],"answer":""},{"type":"多选题","stem":"对（），国务院负责特种设备安全监督管理的部门应当立即报告国务院并通报国务院安全生产监督管理部门等有关部门。","options":[],"answer":""},{"type":"单选题","stem":"气压制动的车辆，有效制动气压低于规定贮气量时，严禁车辆（）","options":[{"key":"A","text":"停车"},{"key":"B","text":"制动"},{"key":"C","text":"起步"},{"key":"D","text":"发动"}],"answer":"C"},{"type":"单选题","stem":"特种设备安全工作应当坚持（）、预防为主、节能环保、综合治理的原则。","options":[],"answer":""},{"type":"判断题","stem":"未经定期检验或者定期检验不合格的特种设备，不得继续使用","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"制动器最大制动效能在踏板 4/5 行程内达到。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"单选题","stem":"制动反应时间中，反射时间是从（）的时间","options":[{"key":"A","text":"制动要求到开始动作"},{"key":"B","text":"开始动作到制动生效"},{"key":"C","text":"制动生效到车辆停止"},{"key":"D","text":"制动要求到车辆停止"}],"answer":"A"},{"type":"单选题","stem":"安全通过交叉路口，要突出一个“慢”字，严禁一个“()”字。","options":[{"key":"A","text":"快"},{"key":"B","text":"争"},{"key":"C","text":"停"}],"answer":"B"},{"type":"单选题","stem":"车辆装运易燃、易爆、剧毒等危险物时，中途停车应选择安全地点，停车或未卸完货物前，()不得离车。","options":[{"key":"A","text":"驾驶员"},{"key":"B","text":"押运员"},{"key":"C","text":"管理员"},{"key":"D","text":"驾驶员和押运员"}],"answer":"D"},{"type":"多选题","stem":"叉车制动系统常见故障包括（）","options":[{"key":"A","text":"制动失灵"},{"key":"B","text":"制动效果不良"},{"key":"C","text":"制动跑偏"},{"key":"D","text":"制动拖滞"}],"answer":"ABCD"},{"type":"单选题","stem":"物质在瞬间以机械功的形式释放出大量气体和能量的现象称为（）","options":[{"key":"A","text":"着火"},{"key":"B","text":"闪燃"},{"key":"C","text":"爆炸"},{"key":"丁","text":"自燃"}],"answer":"C"},{"type":"单选题","stem":"严禁将各种()放在车辆的驾驶室内。","options":[{"key":"A","text":"证件"},{"key":"B","text":"盛装汽油的容器"},{"key":"C","text":"起重设备的千斤顶"}],"answer":"B"},{"type":"单选题","stem":"黄昏行车对驾驶员来说，是（）的时刻。","options":[{"key":"A","text":"最有利"},{"key":"B","text":"最安全"},{"key":"C","text":"最坏"},{"key":"D","text":"最痛快"}],"answer":"C"},{"type":"多选题","stem":"特种设备作业人员的职责有。（）","options":[{"key":"A","text":"严格执行特种设备有关安全管理制度，并且按照操作规程进行操作"},{"key":"B","text":"按照规定填写作业、交接班记录"},{"key":"C","text":"参加安全教育和技能培训"},{"key":"D","text":"参加应急演练，掌握相应的应急处置技能"}],"answer":"ABCD"},{"type":"单选题","stem":"柴油的十六烷值越（）则自燃性越（）。","options":[],"answer":""},{"type":"判断题","stem":"叉车日常保养项目规定，行车前要检查燃油、润滑油和冷却液是否加足（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"《中华人民共和国特种设备安全法》已由中华人民共和国第十二届全国人民代表大会常务委员会第三次会议于2013年6月29日通过，自（）起施行。","options":[{"key":"A","text":"2014年1月10日"},{"key":"B","text":"2014年3月1日"},{"key":"C","text":"2014年1月1日"}],"answer":"C"},{"type":"判断题","stem":"在平交路有视野盲区的情况下，车辆行至路口鸣喇叭的时间可长一些，以提醒横向来的车辆或行人引起注意。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"《特种设备作业人员证》逾期未复审，仍可申请复审。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"在社会主义市场经济条件下，要促进个人与社会的和谐发展，集体主义原则要求把集体利益与个人利益结合起来。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"按照《特种设备作业人员考核规则》，《特种设备作业人员证》持证人员应当在复审期届满（）个月前，向发证部门提出复审申请。","options":[{"key":"A","text":"1"},{"key":"B","text":"3"},{"key":"C","text":"6"},{"key":"D","text":"12"}],"answer":"B"},{"type":"判断题","stem":"制动反应时间中，反射时间是从制动要求到开始动作的时间","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"新车走合一般行驶里程为（）km。","options":[{"key":"A","text":"500~1000"},{"key":"B","text":"1000~1500"},{"key":"C","text":"1500~2000"},{"key":"D","text":"2000~2500"}],"answer":"B"},{"type":"单选题","stem":"方向盘的自由行程左、右各不得超过（）度。","options":[{"key":"A","text":"30"},{"key":"B","text":"25"},{"key":"C","text":"20"},{"key":"D","text":"15"}],"answer":"D"},{"type":"单选题","