":"A","text":"前进"},{"key":"B","text":"后退"},{"key":"C","text":"车头"},{"key":"D","text":"车旁"}],"answer":"B"},{"type":"判断题","stem":"《中华人民共和国特种设备安全法》自2013年6月29日起施行。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"场（厂）车首次检验资料长期保存，定期检验资料保存不少于（）年。","options":[{"key":"A","text":"6"},{"key":"B","text":"5"},{"key":"C","text":"3"},{"key":"D","text":"1"}],"answer":"C"},{"type":"单选题","stem":"叉车传动轴主要由轴管、伸缩套和（）组成","options":[{"key":"A","text":"万向节"},{"key":"B","text":"驱动桥"},{"key":"C","text":"变速器"},{"key":"D","text":"减速器"}],"answer":"A"},{"type":"判断题","stem":"从业人员在任何情况下，必须绝对服从领导的指挥和完成其所分配的任务。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"单选题","stem":"下面（）表述是制动信号灯。","options":[{"key":"A","text":"亮灭交替的闪光，光色为橙色"},{"key":"B","text":"动作时发出强烈的红光"},{"key":"C","text":"安装于车辆前后两侧边缘"},{"key":"D","text":"左右转向信号灯同时闪烁"}],"answer":"B"},{"type":"单选题","stem":"一、二级维护是（）进行的。","options":[{"key":"A","text":"操作人员"},{"key":"B","text":"驾驶人员"},{"key":"C","text":"专业维修人员"},{"key":"D","text":"管理人员"}],"answer":"C"},{"type":"判断题","stem":"《工业企业厂内铁路、道路运输安全规程》规定：路面宽度 9m 以上的道路，应划中心线，实行分道行车。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"特种设备检验机构或技术机构通过（）或相应技术服务对特种设备重大事故隐患的判定提供技术支持","options":[{"key":"A","text":"监督检验"},{"key":"B","text":"定期检验"},{"key":"C","text":"鉴定评审"},{"key":"D","text":"型式试验"}],"answer":"ABCD"},{"type":"单选题","stem":"发生较大事故，对事故发生负有责任的单位的主要负责人未依法履行职责或者负有领导责任的，依照规定处（）罚款","options":[{"key":"A","text":"上一年年收入百分之三十的"},{"key":"B","text":"上一年年收入百分之四十的"},{"key":"C","text":"上一年年收入百分之五十的"},{"key":"D","text":"上一年年收入百分之六十的"}],"answer":"B"},{"type":"多选题","stem":"特种设备生产、经营、使用单位应当对其使用的特种设备进行经常性（）和定期（），并作出记录。","options":[{"key":"A","text":"自行检查"},{"key":"B","text":"检验"},{"key":"C","text":"检修"},{"key":"D","text":"维护保养"}],"answer":"AD"},{"type":"多选题","stem":"特种设备安全技术档案包括（）","options":[{"key":"A","text":"设备日常运行状况记录"},{"key":"B","text":"设备维护保养记录"},{"key":"C","text":"设备检验检测记录"},{"key":"D","text":"设备事故记录"}],"answer":"ABCD"},{"type":"单选题","stem":"企业内机动车辆伤害事故还与驾驶员的年龄有关，一般发生在（）岁的人中居多","options":[{"key":"A","text":"18~20"},{"key":"B","text":"18~40"},{"key":"C","text":"25~55"},{"key":"D","text":"55 以上"}],"answer":"B"},{"type":"判断题","stem":"饮酒对驾驶机能有很好的帮助作用。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"《特种设备安全监察条例》规定，特种设备生产单位对其生产的特种设备的使用性能负责。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"万向传动装置的作用是将变速器输出的动力顺利地传给驱动桥","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"遇险时要就轻避重，在避让时靠近损失或危害较轻的一方避让","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"《特种设备安全监察条例》规定：（）等以及高耗能特种设备的设计文件，应当经核准的检验检测机构鉴定，方可用于制造","options":[{"key":"A","text":"锅炉"},{"key":"B","text":"气瓶"},{"key":"C","text":"氧舱"},{"key":"D","text":"压力管道"}],"answer":"ABCD"},{"type":"判断题","stem":"驾驶中的判断，是处理已观察到的信息和进行“意志”决定的过程（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"普通十字轴万向节两轴无法等角速度转动。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"《特种设备作业人员监督管理办法》规定特种设备作业人员应当按照国家有关规定经特种设备安全监督管理部门考核合格，取得国家统一格式的（），方可从事相应的作业或管理。","options":[{"key":"A","text":"特种设备作业人员证书"},{"key":"B","text":"操作证"},{"key":"C","text":"IC 卡"},{"key":"D","text":"资格证"}],"answer":"A"},{"type":"单选题","stem":"在冰冻、积雪的道路上行驶时，制动距离的主要特点是（）。","options":[],"answer":""},{"type":"单选题","stem":"机动车行驶：机动车在无限速标志的厂内主干道行驶时，不得超过（）km/h。","options":[{"key":"A","text":"50"},{"key":"B","text":"40"},{"key":"C","text":"30"},{"key":"D","text":"20"}],"answer":"C"},{"type":"单选题","stem":"叉车型号“CPQ10B”中表示该叉车的传动形式是（）","options":[{"key":"A","text":"液压传动"},{"key":"B","text":"动压传动"},{"key":"C","text":"机械传动"},{"key":"D","text":"静压传动"}],"answer":"C"},{"type":"单选题","stem":"平衡重式叉车后部装有平衡重块的目的是为了保持叉车（）","options":[{"key":"A","text":"稳定性"},{"key":"B","text":"横向稳定性"},{"key":"C","text":"纵向稳定性"},{"key":"D","text":"侧向稳定性"}],"answer":"C"},{"type":"多选题","stem":"车辆装运易燃、易爆、剧毒等危险物时，车厢周围严禁（）；两台以上车辆跟踪运输时，两车最小间距为 50m，行驶中不得紧急制动，严禁（）。","options":[{"key":"A","text":"聚集"},{"key":"B","text":"烟火"},{"key":"C","text":"超车"},{"key":"D","text":"超速"}],"answer":"BD"},{"type":"判断题","stem":"根据《特种设备作业人员监督管理办法》，持证作业人员违反特种设备的操作规程和有关的安全规章制度操作，情节严重的，应当撤销《特种设备作业人员证》，且3年内不得再次申请《特种设备作业人员证》。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"多选题","stem":"特种设备使用登记办理程序包括（）","options":[{"key":"A","text":"申请"},{"key":"B","text":"受理"},{"key":"C","text":"审查"},{"key":"D","text":"颁证"}],"answer":"ABCD"},{"type":"多选题","stem":"使用单位应当对在用场车进行经常性维护保养和定期自行检查，定期自行检查分为()和()检查。","options":[{"key":"A","text":"日检"},{"key":"B","text":"周检"},{"key":"C","text":"月度检查"},{"key":"D","text":"年度"}],"answer":"CD"},{"type":"判断题","stem":"坡度用百分比表示。()","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"多选题","stem":"特种设备检验检测机构和检验检测人员应当客观、公正、及时地出具检验检测结果、鉴定结论，对检验检测结果、鉴定结论负责，不得有（）行为","options":[{"key":"A","text":"出具虚假的检验检测结果、鉴定结论"},{"key":"B","text":"出具严重失实的检验检测结果、鉴定结论"},{"key":"C","text":"泄露检验检测过程中知悉的商业秘密"},{"key":"D","text":"违规收取检验检测费用"}],"answer":"ABCD"},{"type":"单选题","stem":"鼓式制动器的旋转部分是（）。","options":[],"answer":""},{"type":"单选题","stem":"离合器是保证汽车能（），变速器便于换档，并防止传动系过载。","options":[],"answer":""},{"type":"判断题","stem":"申请《特种设备作业人员证》的人员应当有与申请作业种类相适应的文化程度。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"特种设备发生特别重大事故，由（）组织事故调查组进行调查","options":[],"answer":""},{"type":"多选题","stem":"特种设备使用单位有下列哪些行为之一的，责令限期改正；逾期未改正的，责令停止使用有关特种设备，处一万元以上十万元以下罚款：（）","options":[{"key":"A","text":"未按照安全技术规范的要求及时申报并接受检验的"},{"key":"B","text":"未建立特种设备安全技术档案或者安全技术档案不符合规定要求，或者未依法设置使用登记标志、定期检验标志的"},{"key":"C","text":"使用特种设备未按照规定办理使用登记的"},{"key":"D","text":"未对其使用的特种设备进行经常性维护保养和定期自行检查，或者未对其使用的特种设备的安全附件、安全保护装置进行定期校验、检修，并作出记录的"}],"answer":"ABCD"},{"type":"判断题","stem":"《特种设备作业人员监督管理办法》规定：单位可以使用非法印制、伪造、涂改、倒卖、出租、出借《特种设备作业人员证》。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"接触器是一种自动的电磁式开关，它通过电磁力和弹簧反力使触头闭合和分断","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"《特种设备作业人员考核规则》规定，特种设备作业人员考试成绩有效期为（）。","options":[{"key":"A","text":"12个月"},{"key":"B","text":"24个月"},{"key":"C","text":"3个月"},{"key":"D","text":"6个月"}],"answer":"A"},{"type":"判断题","stem":"坚持三级动火制度。()","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"判断题","stem":"一物体不论在什么地方，不论放置方位怎样变化，其重心位置是不变的。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"特种设备安全也是安全生产工作的（）环节","options":[{"key":"A","text":"延伸"},{"key":"B","text":"重要"},{"key":"C","text":"次要"},{"key":"D","text":"替代"}],"answer":"B"},{"type":"单选题","stem":"机动车离合器分离时，可（）。","options":[],"answer":""},{"type":"多选题","stem":"特种设备生产、经营、使用单位及其主要负责人对其生产、经营、使用的特种设备安全负责，应当做到（）","options":[{"key":"A","text":"建立、健全特种设备安全责任制"},{"key":"B","text":"制定特种设备安全管理制度和操作规程"},{"key":"C","text":"保证特种设备安全投入"},{"key":"D","text":"对特种设备安全管理人员、检测人员和作业人员进行安全教育和技能培训"}],"answer":"ABCD"},{"type":"多选题","stem":"《特种设备作业人员监督管理办法》规定用人单位应当加强对特种设备作业现场和作业人员的管理，并履行以下哪些义务？","options":[{"key":"A","text":"制订特种设备操作规程和有关安全管理制度"},{"key":"B","text":"聘用持证作业人员，并建立特种设备作业人员管理档案"},{"key":"C","text":"对作业人员进行安全教育和培训"},{"key":"D","text":"确保持证上岗和按章操作"}],"answer":"ABCD"},{"type":"单选题","stem":"多辆车同时装卸时，沿横向两车厢板的间距不小于（）m。","options":[],"answer":""},{"type":"多选题","stem":"影响叉车横向稳定性的因素包括（）","options":[{"key":"A","text":"行驶路面倾斜度（横坡）过大"},{"key":"B","text":"货物偏载"},{"key":"C","text":"行驶速度过快且转弯过急"},{"key":"D","text":"左右轮胎气压不一致"}],"answer":"ABCD"},{"type":"判断题","stem":"场车的日常维护保养、自行检查由使用单位的场车作业人员实施，全面检查由使用单位的场车安全管理人员负责组织实施。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"多选题","stem":"特种设备生产、使用单位应当建立健全特种设备（）制度？","options":[{"key":"A","text":"安全管理制度"},{"key":"B","text":"节能管理制度"},{"key":"C","text":"岗位安全制度"},{"key":"D","text":"节能责任制度"}],"answer":"ABCD"},{"type":"单选题","stem":"影响叉车纵向稳定性的因素是（）","options":[{"key":"A","text":"行驶路面倾斜度（横坡）过大"},{"key":"B","text":"货物的重量"},{"key":"C","text":"行驶速度过快且转弯过急"},{"key":"D","text":"左右轮胎气压不一致"}],"answer":"B"},{"type":"判断题","stem":"在相对运动的两个接触表面之间加入润滑剂从而使两接触表面之间的摩擦变为润滑剂分子间的内摩擦，达到减少摩擦、降低磨损、延长机械设备使用寿命的方法叫做润滑。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"厂内运输是企业生产的重要组成部分，生产效率的提高必须依赖良好的（）。","options":[],"answer":""},{"type":"单选题","stem":"变速器没有（）的功用。","options":[{"key":"A","text":"在不改变发动机曲轴旋转方向的前提下，使汽车能倒向行驶"},{"key":"B","text":"利用空档，使发动机与传动系中断动力传递"},{"key":"C","text":"进行动力输出"},{"key":"D","text":"提高发动机功率"}],"answer":"D"},{"type":"判断题","stem":"定期检查和更换油缸油封是防止油缸漏油的一种方法。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"方向摇臂轴和锯齿损坏不得超过2牙。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"驾驶技术不熟练的主要原因是缺乏正规培训和严格考核，主要表现为：1. 不能正确判断和处理险情。2. 不能正确控制和运用车辆。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"对经常行驶的厂区道路，驾驶员要注意观察并熟记沿线的路口、叉道，注意观察并熟记行人经常出入的地点，做到胸中有数以防事故发生。这体现了驾驶员的（）意识","options":[{"key":"A","text":"安全预判"},{"key":"B","text":"效率优先"},{"key":"C","text":"设备保护"},{"key":"D","text":"规范操作"}],"answer":"A"},{"type":"判断题","stem":"叉车空气滤芯禁止用水、油清洗。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"机械式传动只能实现有级变速。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"力作用在物体上所产生的效果，不但与力的大小和方向有关，而且与力的（）有关","options":[{"key":"A","text":"作用点"},{"key":"B","text":"作用方式"},{"key":"C","text":"作用时间"},{"key":"D","text":"作用介质"}],"answer":"A"},{"type":"单选题","stem":"驾驶员坚持“三检”是保证行车安全和保证车辆良好技术状况的基本要求。但是（）。","options":[],"answer":""},{"type":"判断题","stem":"润滑油（脂）应避免放置在室外阳光直射，否则会增加油的分离。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"场车的铭牌、安全标志及其说明应当设置在车辆的最重要位置。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"叉车汽油发动机的起动电动机的蓄电池电压一般为（）。","options":[{"key":"A","text":"36V"},{"key":"B","text":"48V"},{"key":"C","text":"12V"},{"key":"D","text":"24V"}],"answer":"C"},{"type":"单选题","stem":"特种设备重大事故隐患是指在特种设备使用过程中，存在的危害程度较大、可能导致（）或造成重大经济损失的潜在不安全情形。","options":[{"key":"A","text":"群死群伤"},{"key":"B","text":"社会影响"},{"key":"C","text":"设备故障"},{"key":"D","text":"企业停产"}],"answer":"A"},{"type":"单选题","stem":"特种设备生产、使用单位和特种设备检验检测机构，应当保证必要的安全和（）投入。","options":[{"key":"A","text":"检验"},{"key":"B","text":"节能"},{"key":"C","text":"环保"},{"key":"D","text":"修理"}],"answer":"B"},{"type":"判断题","stem":"酸性蓄电池负极是海绵状铅。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"三检：出车前、作业中、收车后。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"转向系是指用于改变或控制车辆行驶方向的机构。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"特种设备作业考试合格分数线 70 分。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"在厂内运输过程中，由于货运距离短，货物可不固定或捆绑。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"对车辆不经常进行检查，凑合使用，往往会因车辆转向器、制动器、信号装置等失灵和失效，导致事故的发生。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"《特种设备安全法》适用于特种设备的生产（包括设计、制造、安装、改造、修理）、经营、使用、检验、检测和特种设备安全的监督管理。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"《特种设备使用管理规则》规定，特种设备安全技术档案应包括","options":[{"key":"A","text":"特种设备定期自行检查记录和定期检验报告"},{"key":"B","text":"特种设备日常使用状况记录"},{"key":"C","text":"特种设备安全附件和安全保护装置校验、检修、更换记录和有关报告"},{"key":"D","text":"特种设备运行故障和事故记录及事故处理报告"}],"answer":"ABCD"},{"type":"单选题","stem":"在相对运动的两个接触表面之间加入润滑剂从而使两接触表面之间的摩擦变为润滑剂分子间的内摩擦，达到减少摩擦、降低磨损、延长机械设备使用寿命的方法叫做（）","options":[{"key":"A","text":"冷却"},{"key":"B","text":"润滑"},{"key":"C","text":"密封"},{"key":"D","text":"防腐"}],"answer":"B"},{"type":"单选题","stem":"发动机能够把（），实现动力输出。","options":[],"answer":""},{"type":"判断题","stem":"《特种设备安全法》规定：特种设备使用单位如果使用未取得许可生产，未经检验或者检验不合格的特种设备，或者国家明令淘汰、已经报废的特种设备的，将被责令停止使用有关特种设备，并处三万元以上三十万元以下罚款。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"根据《特种设备作业人员监督管理办法》，发证部门对申请人报送的材料应当当场审查、当场办理。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"当超车时确认前车让超后，与被超车保持一定的横向间距、()。","options":[],"answer":""},{"type":"判断题","stem":"特种设备生产、经营、使用单位擅自动用、调换、转移、损毁被查封、扣押的特种设备或者其主要部件的，责令改正，处五万元以上二十万元以下罚款。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"根据 TSG08-2017《特种设备使用管理规则》2.4.4.2 条规定，特种设备使用时应当保证每班（）持证人员在岗","options":[{"key":"A","text":"二名"},{"key":"B","text":"至少一名"},{"key":"C","text":"至少二名"},{"key":"D","text":"三名"}],"answer":"B"},{"type":"单选题","stem":"道路的纵截面坡度通常用两点间高度差（垂直距离）与道路中心线的水平长度（水平距离）的（）来表示。","options":[],"answer":""},{"type":"单选题","stem":"蓄电池叉车电池电量下降到总电量的（）时，必须立即停车，并且尽快充电，防止蓄电池过分放电而受到伤害。","options":[],"answer":""},{"type":"单选题","stem":"在机床、管道和设备旁行驶时，其距离不得小于（）m","options":[{"key":"A","text":"0.2"},{"key":"B","text":"0.3"},{"key":"C","text":"0.4"},{"key":"D","text":"0.5"}],"answer":"D"},{"type":"单选题","stem":"在厂区行驶时，当车行至交叉路口，通常应提前（）米将车速降至 10 公里/小时以下","options":[],"answer":""},{"type":"单选题","stem":"轮胎按其结构不同，可以分为（）","options":[{"key":"A","text":"实心胎和充气轮胎"},{"key":"B","text":"高压胎和低压胎"},{"key":"C","text":"子午线胎和斜交胎"},{"key":"D","text":"前轮胎和后轮胎"}],"answer":"C"},{"type":"判断题","stem":"按总局 140 号令规定，《特种设备作业人员证》每 2 年复审一次。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"液压制动是将制动踏板力转换为（）来实现制动效果的","options":[],"answer":""},{"type":"单选题","stem":"特种设备使用单位应当对其使用的特种设备进行（）维护保养和定期自行检查。","options":[{"key":"A","text":"定期"},{"key":"B","text":"周期性"},{"key":"C","text":"经常性"},{"key":"D","text":"年度"}],"answer":"C"},{"type":"多选题","stem":"叉车液压系统常见故障包括（）","options":[{"key":"A","text":"泄漏"},{"key":"B","text":"噪音"},{"key":"C","text":"压力不足"},{"key":"D","text":"动作缓慢"}],"answer":"ABCD"},{"type":"单选题","stem":"前照灯由灯泡、反射镜、（）三部分组成。","options":[{"key":"A","text":"支架"},{"key":"B","text":"充气气体"},{"key":"C","text":"配光镜"}],"answer":"C"},{"type":"单选题","stem":"前照灯应具有保证车前有（）米以上明亮而均匀的照明。","options":[{"key":"A","text":"50-70"},{"key":"B","text":"70-80"},{"key":"C","text":"80-90"},{"key":"D","text":"100"}],"answer":"D"},{"type":"单选题","stem":"操纵油门踏板时，应将（）靠在驾驶室底板上作为支点。","options":[],"answer":""},{"type":"判断题","stem":"特种设备使用单位应当对在用特种设备安全附件定期校验、检修，并作出记录。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"离合器作用是平稳起步。()","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"叉车使用中，如果将货叉更换为其他属具，该设备的使用安全由使用单位负责。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"特种设备使用单位应当使用取得许可生产并经（）的特种设备","options":[{"key":"A","text":"验收"},{"key":"B","text":"检验合格"},{"key":"C","text":"调试"},{"key":"D","text":"登记"}],"answer":"B"},{"type":"判断题","stem":"特种设备报废后，使用单位必须到县市区特种设备安全监督管理部门将报废的特种设备注销。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"厂内运输是企业在生产加工过程中各道工序之间联系的（）。","options":[{"key":"A","text":"纽带"},{"key":"B","text":"关键"},{"key":"C","text":"工具"}],"answer":"A"},{"type":"单选题","stem":"机件高速运转时，温度升高，零件表面油膜稳定性遭到破坏，机件磨损（）。","options":[{"key":"A","text":"缓慢"},{"key":"B","text":"稳定"},{"key":"C","text":"加剧"},{"key":"D","text":"不受影响"}],"answer":"C"},{"type":"多选题","stem":"驾驶员在日常操作中应做到的“三勤”要求，是指（）","options":[{"key":"A","text":"勤检查"},{"key":"B","text":"勤保养"},{"key":"C","text":"勤调整"},{"key":"D","text":"勤清洁"}],"answer":"ABC"},{"type":"单选题","stem":"在低温环境下，机动车发动机的润滑性能（）","options":[{"key":"A","text":"提高"},{"key":"B","text":"降低"},{"key":"C","text":"不变"},{"key":"D","text":"先提高后降低"}],"answer":"B"},{"type":"多选题","stem":"轮胎按其结构不同，可以分为（）","options":[{"key":"A","text":"实心胎"},{"key":"B","text":"充气轮胎"},{"key":"C","text":"高压胎"},{"key":"D","text":"低压胎"}],"answer":"AB"},{"type":"判断题","stem":"海拔高度每增加1000m，发动机功率也将下降10%左右。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"跨越道路上空的建（构）筑物（含桥梁、隧道等）距路面的最小净高，应按行驶车辆的最大高度或车辆装载物料后的最大高度另加（）m的安全间距采用，并不宜小于（）m。","options":[{"key":"A","text":"0.5~1米"},{"key":"B","text":"1~2米"},{"key":"C","text":"4米"},{"key":"D","text":"5米"}],"answer":"AD"},{"type":"单选题","stem":"企业内道路应经常保持路面平整、路基稳固边坡整齐、排水良好，并应（）。","options":[{"key":"A","text":"设立禁止车辆、行人通行的标志"},{"key":"B","text":"设置行人地道或天桥、环行岛"},{"key":"C","text":"有良好的照明设施"},{"key":"D","text":"划分人行道与车行道"}],"answer":"D"},{"type":"单选题","stem":"底盘的作用是接受发动机输出的动力使车辆（）且保证车辆正常行驶。","options":[{"key":"A","text":"产生能量"},{"key":"B","text":"接收热能"},{"key":"C","text":"发出电能"},{"key":"D","text":"产生运动"}],"answer":"D"},{"type":"单选题","stem":"万向传动装置的作用是将变速器输出的动力顺利地传给（）","options":[{"key":"A","text":"发动机"},{"key":"B","text":"驱动桥"},{"key":"C","text":"转向桥"},{"key":"D","text":"车架"}],"answer":"B"},{"type":"多选题","stem":"禁止标志：禁止或限制车辆、行人交通行为的标志。通常为圆形、八角形或（）的等边三角形，颜色多为（）、红边、黑色图案上压（）。","options":[{"key":"A","text":"顶角朝上"},{"key":"B","text":"顶角朝下"},{"key":"C","text":"红色斜杠"},{"key":"D","text":"白底"}],"answer":"ACD"},{"type":"判断题","stem":"《特种设备作业人员考核规则》TSGZ6001-2019规定，考试实行百分制，单科成绩达到60分为合格；每科均合格，评定为考试合格。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"下面（）属于日常维护的内容","options":[],"answer":""},{"type":"判断题","stem":"遇险时要保持清醒，采用正确的避让动作，往往能及时中止事故，使损失减少到最低限度。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"使用合格的特种设备是保证特种设备安全运行的最基本的条件（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"检查转向器，横直拉杆与前轴的连接应定位正确，（）安全可靠，转动灵活，无卡阻现象。","options":[{"key":"A","text":"转动装置"},{"key":"B","text":"操纵装置"},{"key":"C","text":"锁止装置"}],"answer":"C"},{"type":"判断题","stem":"在平交路有视野盲区的情况下，车辆行至路口鸣喇叭的时间可长一些，以提醒横向来的车辆或行人引起注意","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"特种设备使用单位在特种设备管理工作中应承担（）责任。","options":[{"key":"A","text":"技术保障"},{"key":"B","text":"监督"},{"key":"C","text":"主体"},{"key":"D","text":"连带"}],"answer":"C"},{"type":"判断题","stem":"根据《特种设备使用管理规则》的要求，使用单位应对在用特种设备进行经常性维护保养和定期自行检查，及时排查和消除事故隐患；对在用特种设备的安全附件、安全保护装置及其附属仪器仪表进行定期校验（检定、校准）、检修，及时提出定期检验和能效测试申请，接受定期检验和能效测试，并且做好相关配合工作。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"当车辆停车或遇有紧急情况时，利用（）同时闪烁，以引起其它行驶车辆的注意。","options":[],"answer":""},{"type":"单选题","stem":"违章是发生事故的根源。各种安全规章制度和安全（）都是大量事故教训的总结","options":[{"key":"A","text":"班组会"},{"key":"B","text":"小组会"},{"key":"C","text":"操作规程"},{"key":"D","text":"操作宣讲"}],"answer":"C"},{"type":"单选题","stem":"《重庆市特种设备安全条例》自（）起实行。","options":[{"key":"A","text":"2020年7月1日"},{"key":"B","text":"2020年8月1日"},{"key":"C","text":"2020年9月1日"},{"key":"D","text":"2020年10月1日"}],"answer":"C"},{"type":"单选题","stem":"有下列情况之一的为特种设备一般事故，特种设备事故造成 3 人以下死亡，或者（）人以下重伤，或者 1 万元以上 1000 万元以下直接经济损失的","options":[],"answer":""},{"type":"判断题","stem":"危险货物运输车辆必须持有准运证。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"力作用在物体上所产生的效果，不但与力的大小和方向有关，而且与力的作用点有关","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"内燃叉车发动机后置，前桥为（），后桥为（）。","options":[],"answer":""},{"type":"单选题","stem":"叉车传动轴主要由轴管、伸缩套和（）组成","options":[{"key":"A","text":"万向节"},{"key":"B","text":"驱动桥"},{"key":"C","text":"变速器"},{"key":"D","text":"减速器"}],"answer":"A"},{"type":"单选题","stem":"叉车的型号表示方法中，动力类型代号“Q”表示（）","options":[{"key":"A","text":"柴油"},{"key":"B","text":"汽油"},{"key":"C","text":"石油气"},{"key":"D","text":"蓄电池"}],"answer":"B"},{"type":"单选题","stem":"《特种设备作业人员证》遗失或者损毁的，持证人应当及时报告（），并在当地媒体予以公告。查证属实的，由发证部门补办证书。","options":[{"key":"A","text":"单位领导"},{"key":"B","text":"监管部门"},{"key":"C","text":"上级部门"},{"key":"D","text":"发证部门"}],"answer":"D"},{"type":"单选题","stem":"企业内机动车辆驾驶员（）企业安技部门、主管部门及其管理人员的监督、检查和处理。","options":[{"key":"A","text":"间接服从"},{"key":"B","text":"部分服从"},{"key":"C","text":"必须服从"}],"answer":"C"},{"type":"单选题","stem":"叉车液压油（）不同品种和牌号的液压油混用","options":[{"key":"A","text":"可以"},{"key":"B","text":"不可以"},{"key":"C","text":"紧急情况下可以"},{"key":"D","text":"过滤后可以"}],"answer":"B"},{"type":"单选题","stem":"在厂房、料库、仓库、窄路及视线不良地段倒车时，须有（）指挥","options":[{"key":"A","text":"专人"},{"key":"B","text":"驾驶员自己"},{"key":"C","text":"仓库管理员"},{"key":"D","text":"其他驾驶员"}],"answer":"A"},{"type":"单选题","stem":"交接班制度中，交接手续应明确（）。","options":[{"key":"A","text":"本班工作人员工作表现"},{"key":"B","text":"巡回检查次数"},{"key":"C","text":"操作参数"},{"key":"D","text":"交接班记录的填写及签名要求"}],"answer":"D"},{"type":"判断题","stem":"在路面窄的交叉路口行驶，由于视线盲区较大，视距短，车速应尽量降低在 5 公里小时以下。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"《特种设备使用登记证》的发证机关是（）。","options":[],"answer":""},{"type":"单选题","stem":"干燥的沥青或混凝土路面的附着系数比干燥的土路附着系数值（）","options":[{"key":"A","text":"大"},{"key":"B","text":"小"},{"key":"C","text":"无变化"},{"key":"D","text":"不确定"}],"answer":"A"},{"type":"判断题","stem":"警告标志顶角朝上等边三角形。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"按《特种设备作业人员考核规则》规定，发证机关应当在（）或者（）后的20个工作日内，将相关信息上传“全国特种设备公示信息查询平台”。","options":[{"key":"A","text":"发证"},{"key":"B","text":"复审"},{"key":"C","text":"考试"},{"key":"D","text":"以上都对"}],"answer":"AB"},{"type":"判断题","stem":"《特种设备作业人员考核规则》TSGZ6001-2019规定，持证人员应当在持证项目有效期属满的3个月以前，向所在地或者户籍（户口或者居住证所在地的发证机关提出复审申请。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"叉车载货行驶时货件离地高度不得大于 500 毫米，起升门架须后倾到限（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"特种设备作业人员在作业过程中发现事故隐患或其它不安全因素，应当（）向现场安全管理人员和单位有关负责人报告","options":[],"answer":""},{"type":"判断题","stem":"叉车日常保养项目规定，行车前要检查全车油、水有无渗漏现象","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"按照《特种设备安全监察条例》的规定，特种设备事故分为特别重大事故、重大事故、严重事故和一般事故。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"遇险情要先顾物后顾人","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"单选题","stem":"企业内机动车辆驾驶员不准驾驶（）车辆。","options":[{"key":"A","text":"与准驾车类不相符的"},{"key":"B","text":"悬挂试车牌照的"},{"key":"C","text":"悬挂教练车牌照的"}],"answer":"A"},{"type":"单选题","stem":"车辆会车要做到“礼让三先”即先让、先慢、()，并注意非机动车和来往行人。","options":[],"answer":""},{"type":"单选题","stem":"差速器作用之一是（）。","options":[],"answer":""},{"type":"判断题","stem":"爆炸是瞬间释放大量气体和能量的现象。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"多选题","stem":"特种设备使用登记办理程序包括（）。","options":[{"key":"A","text":"申请"},{"key":"B","text":"受理"},{"key":"C","text":"审查"},{"key":"D","text":"颁证"}],"answer":"ABCD"},{"type":"判断题","stem":"维护保养和定期检验工作是特种设备使用单位的一项义务，也是提高设备使用寿命的重要手段","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"必须在坡道上停车时，要选择安全位置，停好后要（），并用三角垫木或石块塞住车轮，防止滑溜。","options":[{"key":"A","text":"拉紧驻车制动器的同时挂上一挡或倒挡；"},{"key":"B","text":"前轮朝向坡上，方向盘转至极限位置后；"},{"key":"C","text":"车辆横向停在坡道上，以防止车辆滑溜。"}],"answer":"A"},{"type":"单选题","stem":"驾驶员应熟悉所驾车辆的性能和技术状况，并能（）","options":[{"key":"A","text":"安全驾驶车辆"},{"key":"B","text":"按时完成任务"},{"key":"C","text":"及时发现故障，及时排除"},{"key":"D","text":"调整车辆参数"}],"answer":"C"},{"type":"单选题","stem":"变速器主要功用是（）以适应经常变化的复杂行驶条件。","options":[],"answer":""},{"type":"单选题","stem":"放松制动踏板时应（）。","options":[],"answer":""},{"type":"单选题","stem":"根据《特种设备作业人员监督管理办法》，复审不合格、逾期未复审的，其《特种设备作业人员证》予以（）。","options":[],"answer":""},{"type":"单选题","stem":"《中华人民共和国特种设备安全法》是一部（）。","options":[{"key":"A","text":"安全技术法规"},{"key":"B","text":"行政规章"},{"key":"C","text":"法律"},{"key":"D","text":"行政法规"}],"answer":"C"},{"type":"判断题","stem":"特种设备使用单位应当保证必要的安全和节能投入。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"驾驶车辆时，身体（）方向盘坐稳，两手握紧方向盘左右两侧","options":[],"answer":""},{"type":"单选题","stem":"润滑脂的号数代表润滑脂的（）特性","options":[{"key":"A","text":"黏度"},{"key":"B","text":"针入度"},{"key":"C","text":"稠度"},{"key":"D","text":"滴点"}],"answer":"C"},{"type":"判断题","stem":"对人身和财产安全有较大危险性的设备，就是特种设备。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"车辆超车应选择道路宽直、视线良好，路侧左右无障碍，并在交通规则许可的情况下进行","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"下面各种情况会造成叉车叉架歪斜故障的有（）","options":[{"key":"A","text":"侧向滚轮间隙过大"},{"key":"B","text":"两链条张紧度不一致"},{"key":"C","text":"起升油缸中有空气"},{"key":"D","text":"驱动轮胎气压不一致"}],"answer":"ABCD"},{"type":"判断题","stem":"叉车转向系统的功用是保障叉车直线行驶和灵活地改变叉车行驶方向。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"驾驶员应特别注意厂房内的起重机动态，车辆不得在起重机的吊钩或（）下通行","options":[{"key":"A","text":"驾驶室"},{"key":"B","text":"索具"},{"key":"C","text":"车轮"},{"key":"D","text":"轨道"}],"answer":"B"},{"type":"单选题","stem":"特种设备作业人员应履行以下义务（）。","options":[{"key":"A","text":"应当严格执行特种设备的操作规程和有关的安全规章制度"},{"key":"B","text":"作业人员发现事故隐患立即停止设备运行的义务"},{"key":"C","text":"绝对服从领导指挥的义务"},{"key":"D","text":"作好维修记录的义务"}],"answer":"A"},{"type":"判断题","stem":"平衡重式叉车平衡重是保证纵向稳定。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"动视力与驾驶员的年龄有关，年龄愈大，动视力与静视力之差愈大","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"转向系统应当转动灵活、操纵方便、无卡滞，在任意转向操作时可与其他部件有干涉。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"单选题","stem":"发生较大事故，对负责责任的单位除要求其依法承担相应的赔偿等责任外，依照规定处以（）罚款","options":[{"key":"A","text":"二万元以上十万元以下"},{"key":"B","text":"十万元以上二十万元以下"},{"key":"C","text":"二十万元以上五十万元以下"},{"key":"D","text":"五万元以上二百万元以下"}],"answer":"C"},{"type":"单选题","stem":"动视力与驾驶员的年龄有关，年龄愈大，动视力与静视力之差（）","options":[{"key":"A","text":"愈大"},{"key":"B","text":"愈小"},{"key":"C","text":"无变化"},{"key":"D","text":"先大后小"}],"answer":"A"},{"type":"单选题","stem":"停车前应缓慢地向道路右侧或停车地点靠近，轻踏（）踏板，使车辆停止。","options":[{"key":"A","text":"油门"},{"key":"B","text":"转向离合器"},{"key":"C","text":"制动器"},{"key":"D","text":"离合器"}],"answer":"C"},{"type":"单选题","stem":"车速过快对人、车辆（）不利影响","options":[{"key":"A","text":"不会带来"},{"key":"B","text":"会带来"},{"key":"C","text":"偶尔会带来"},{"key":"D","text":"可能会带来"}],"answer":"B"},{"type":"单选题","stem":"特种设备作业人员应当遵守的规定不包括（）","options":[{"key":"A","text":"积极参加特种设备安全教育和安全技术培训"},{"key":"B","text":"严格执行特种设备操作规程和有关安全规章制度"},{"key":"C","text":"服从违章指挥"},{"key":"D","text":"发现事故隐患或者不安全因素应当立即向现场管理人员和单位有关负责人报告"}],"answer":"C"},{"type":"单选题","stem":"未经定期检验或者定期检验不合格的特种设备，()继续使用","options":[{"key":"A","text":"可以"},{"key":"B","text":"不可以"},{"key":"C","text":"紧急情况下可以"},{"key":"D","text":"维修后可以"}],"answer":"B"},{"type":"单选题","stem":"转弯半径越（），车辆的机动性能越好。","options":[],"answer":""},{"type":"单选题","stem":"叉车的工作装置由（）两部分组成","options":[],"answer":""},{"type":"判断题","stem":"静液式传动主要由液压泵和液压马达组成。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"电流通过人体的持续时间（），则救护的可能性越小。","options":[],"answer":""},{"type":"多选题","stem":"《特种设备作业人员监督管理办法》规定：任何单位和个人不得非法（）、出租或者出借《特种设备作业人员证》。","options":[{"key":"A","text":"印制"},{"key":"B","text":"伪造"},{"key":"C","text":"涂改"},{"key":"D","text":"倒卖"}],"answer":"BCD"},{"type":"单选题","stem":"有下列情况之一的为特种设备一般事故，特种设备事故造成 3 人以下死亡，或者 10 人以下重伤，或者（）直接经济损失的","options":[],"answer":""},{"type":"单选题","stem":"实施特种设备安全监察行政处罚的主体为（）。","options":[],"answer":""},{"type":"单选题","stem":"驱动桥的作用是（）。","options":[],"answer":""},{"type":"判断题","stem":"驾驶叉车在有横向坡度的场地上行驶时，向上坡方向转向容易造成横向翻车","options":[],"answer":"正确"},{"type":"多选题","stem":"特种设备作业人员考试科目包括（）。","options":[{"key":"A","text":"电学"},{"key":"B","text":"理论知识考试"},{"key":"C","text":"实际操作技能考试"},{"key":"D","text":"工程管理"}],"answer":"BC"},{"type":"单选题","stem":"下列哪种情形，不属于应当吊销《特种设备作业人员证》的范围（）","options":[{"key":"A","text":"持证作业人员以考试作弊或者其他欺骗方式取得《特种设备作业人员证》的"},{"key":"B","text":"持证作业人员违章操作或者管理造成特种设备事故的"},{"key":"C","text":"持证作业人员发现事故隐患或者其他不安全因素未立即报告造成特种设备事故的"},{"key":"D","text":"作业时未随身携带作业人员证"}],"answer":"D"},{"type":"判断题","stem":"为了便于低温起动，应适当增加断电触点闭合角度，触点间隙调整为 0.3~0.4mm，以增强火花强度。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"阻止空气流入燃烧区或用不燃烧物质冲淡空气，使燃烧物质得不到足够的氧气而熄灭。这种灭火法称为（）","options":[{"key":"A","text":"冷却法"},{"key":"B","text":"窒息法"},{"key":"C","text":"隔离法"},{"key":"D","text":"抑制法"}],"answer":"B"},{"type":"判断题","stem":"叉车载荷中心距是标准货物重心至货叉垂直段前壁间的水平距离。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"申请人隐瞒有关情况或者提供虚假材料申请《特种设备作业人员证》的，不予受理或者不予批准发证，并在（）年内不得再次申请《特种设备作业人员证》。","options":[{"key":"A","text":"半"},{"key":"B","text":"1"},{"key":"C","text":"2"},{"key":"D","text":"3"}],"answer":"B"},{"type":"判断题","stem":"对特种设备作业人员作业情况进行检查，及时纠正违章作业行为，是特种设备使用单位的主要义务之一。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"《特种设备作业人员监督管理办法》规定，特种设备作业人员，经（），方可从事相应的作业或者管理工作。","options":[{"key":"A","text":"经培训合格取得培训合格证"},{"key":"B","text":"经考核合格取得考试合格证"},{"key":"C","text":"经培训合格取得《特种设备作业人员证》"},{"key":"D","text":"经考核合格取得《特种设备作业人员证》"}],"answer":"D"},{"type":"单选题","stem":"企业内机动车辆驾驶员必须做到（）。","options":[],"answer":""},{"type":"判断题","stem":"根据《特种设备作业人员监督管理办法》，持证作业人员以考试作弊或者其他欺骗方式取得《特种设备作业人员证》的，应当予以注销。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"车辆通过铁路道口，遇道口拦杆放下或发生停车信号时，当路边无停车线时，应停在距外侧铁轨1.5m以外，严禁抢道通过。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"“四漏”检查包括：漏水、漏油、漏电、漏气（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"特种设备安装、改造及重大维修的告知形式有（）。","options":[{"key":"A","text":"信函"},{"key":"B","text":"传真"},{"key":"C","text":"电话"},{"key":"D","text":"直接送达"}],"answer":"ABD"},{"type":"判断题","stem":"按总局第140号令规定，持证特种设备作业人员以考试作弊或者其他欺骗方式取得《特种设备作业人员证》的，持证人5年内不得再次申请《特种设备作业人员证》。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"多选题","stem":"按总局第140号令规定，有下列情形之一的，应当撤销《特种设备作业人员证》。","options":[{"key":"A","text":"持证作业人员以考试作弊或者其他欺骗方式取得《特种设备作业人员证》的"},{"key":"B","text":"持证作业人员违反特种设备的操作规程和有关的安全规章制度操作，情节严重的"},{"key":"C","text":"持证作业人员在作业过程中发现事故隐患或者其他不安全因素未立即报告，情节严重的"},{"key":"D","text":"考试机构或者发证部门工作人员滥用职权、玩忽职守、违反法定程序或者超越发证范围考核发证的"}],"answer":"ABCD"},{"type":"单选题","stem":"普通型蓄电池车不得在（）行驶。","options":[{"key":"A","text":"潮湿、积水的场所"},{"key":"B","text":"人员较多的场所"},{"key":"C","text":"设备较密集的场所"},{"key":"D","text":"易燃、易爆的场所"}],"answer":"D"},{"type":"判断题","stem":"捆绑危险化学品的绳索，应用钢丝绳和铁丝。()","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"错误"},{"type":"判断题","stem":"调整作业：是恢复场（厂）内专用机动车辆良好技术性能和确保正常配合间隙的重要工作。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"特种设备使用单位应当对其使用的特种设备进行监督检验，并作出记录。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"叉车门架自动前后倾的原因分别是：（1）斜倾油缸密封件损坏（2）多路阀不泄漏。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"尽管各种厂内机动车辆使用的工况不一致，但其操作却有共同点。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"特种设备作业人员应当遵守的规定包括（）。","options":[],"answer":""},{"type":"判断题","stem":"《工业企业厂内铁路、道路运输安全规程》规定：路面狭窄或交通量大、容易堵塞的道路，应尽量实行单向通行","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"在厂区内发生车辆事故应（）。","options":[{"key":"A","text":"立即停车保护现场抢救伤员，并第一时间向厂安全部门报案"},{"key":"B","text":"立即停车报警"},{"key":"C","text":"驾车送伤员到医院"}],"answer":"A"},{"type":"判断题","stem":"厂内道路运输：在工业企业厂内道路上使用汽车或其它运输工具，从事货物运输或客运活动的总称","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"润滑作用包含减少磨损、密封、减震。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"《特种设备使用登记证》的发证机关是（）。","options":[],"answer":""},{"type":"判断题","stem":"申请人隐瞒有关情况或者提供虚假材料申请《特种设备作业人员证》的，不予受理或者不予批准发证，并在2年内不得再次申请《特种设备作业人员证》。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"内燃叉车的主要传动方式有（）和动液传动。","options":[{"key":"A","text":"机械传动"},{"key":"B","text":"静液传动"},{"key":"C","text":"无级变速"}],"answer":"A"},{"type":"单选题","stem":"发动机燃料供给系除适时向发动机供给燃料外，()。","options":[],"answer":""},{"type":"单选题","stem":"蓄电池叉车应在（）用抹布蘸 5% 的碳酸钠或氢氧化钠溶液擦去蓄电池极柱及表面外溅电解液。","options":[{"key":"A","text":"出车前"},{"key":"B","text":"作业中"},{"key":"C","text":"收车后"}],"answer":"C"},{"type":"单选题","stem":"特种设备使用登记办理程序包括（）","options":[{"key":"A","text":"申请、受理、审查、颁证"},{"key":"B","text":"申请、审查、颁证"},{"key":"C","text":"受理、审查、颁证"},{"key":"D","text":"申请、受理、颁证"}],"answer":"A"},{"type":"单选题","stem":"平衡重式叉车的平衡重块是为了保持（）。","options":[],"answer":""},{"type":"单选题","stem":"酸性蓄电池所用的电解液浓度一般为（）%的硫酸水溶液。","options":[{"key":"A","text":"20-27"},{"key":"B","text":"37-40"},{"key":"C","text":"27-37"},{"key":"D","text":"39-45"}],"answer":"C"},{"type":"单选题","stem":"触电救护的有关说法错误的是（）。","options":[],"answer":""},{"type":"单选题","stem":"发动机加速不良故障主要在于空燃比不当，点火性能和（）变差","options":[{"key":"A","text":"密封性能"},{"key":"B","text":"冷却性能"},{"key":"C","text":"润滑性能"},{"key":"D","text":"排气性能"}],"answer":"A"},{"type":"单选题","stem":"设备维修保养制度制定的意义是（）","options":[{"key":"A","text":"发现起重机械制造时缺陷"},{"key":"B","text":"主要是解决起重机械安装时的一些缺陷"},{"key":"C","text":"提高设备的完好率"},{"key":"D","text":"有效地防止违章操作"}],"answer":"C"},{"type":"单选题","stem":"在叉车上常作为蓄电池接柱防锈和金属器材封存的是（）","options":[{"key":"A","text":"制动液"},{"key":"B","text":"黄油"},{"key":"C","text":"工业凡士林"},{"key":"D","text":"液压油"}],"answer":"C"},{"type":"判断题","stem":"特种设备安全第一、预防为主。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"汽油机燃料供给系工作不正常的外观或现象中属于混合气过稀的是（）","options":[{"key":"A","text":"发动机不能起动或工作中逐渐熄火"},{"key":"B","text":"转速不易提高"},{"key":"C","text":"怠速不匀"},{"key":"D","text":"加速时消声器短期有“突、突”声"}],"answer":"A"},{"type":"判断题","stem":"只要防范措施到位，车辆在加注燃油时，不必将发动机熄火。（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"特种设备重大事故隐患对应《中华人民共和国特种设备安全法》中的（）","options":[{"key":"A","text":"重大违法行为"},{"key":"B","text":"受处罚行为"},{"key":"C","text":"一般事故隐患"},{"key":"D","text":"严重事故隐患"}],"answer":"D"},{"type":"单选题","stem":"车辆经过弯道时，要提前减速，（），以引起对方车辆、行人注意，避免造成事故。","options":[{"key":"A","text":"鸣号，靠右行"},{"key":"B","text":"鸣号、加速"},{"key":"C","text":"鸣号、靠左行"}],"answer":"A"},{"type":"单选题","stem":"视线的焦点随着速度增加而距离（）。","options":[{"key":"A","text":"变近"},{"key":"B","text":"变远"},{"key":"C","text":"模糊"}],"answer":"B"},{"type":"单选题","stem":"汽油机燃油供给系出现“不供油”故障时，车辆会出现（）状况。","options":[{"key":"A","text":"发动机怠速熄火"},{"key":"B","text":"发动机不易起动"},{"key":"C","text":"发动机起动不了"}],"answer":"C"},{"type":"单选题","stem":"发动机起动车辆，两次起动间隔时间最少不得少于（）s。","options":[{"key":"A","text":"10"},{"key":"B","text":"15"},{"key":"C","text":"20"},{"key":"D","text":"30"}],"answer":"B"},{"type":"判断题","stem":"按国务院《特种设备安全监察条例》规定，重大事故由国务院或者国务院授权有关部门组织事故调查组进行调查。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"机动车拖带损坏车辆，夜间拖带车辆时，被拖带的车辆人员、工具应齐全有效。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"判断题","stem":"在厂房、料库、仓库、窄路及视线不良地段倒车时，须有专人指挥","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"叉车在出现油管或油缸漏油故障时，应立即（）","options":[{"key":"A","text":"继续工作"},{"key":"B","text":"停车，禁止工作"},{"key":"C","text":"降低车速行驶"},{"key":"D","text":"自行维修后继续工作"}],"answer":"B"},{"type":"判断题","stem":"特种设备发生特别重大事故，由当地行政有关部门组织事故调查组进行调查。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"B"},{"type":"单选题","stem":"叉车载货行驶时货件离地高度不得大于（）毫米，起升门架须后倾到限","options":[{"key":"A","text":"300"},{"key":"B","text":"400"},{"key":"C","text":"500"},{"key":"D","text":"600"}],"answer":"C"},{"type":"多选题","stem":"叉车操作过程中，严禁驾驶员有下列哪些行为（）","options":[{"key":"A","text":"酒后驾驶"},{"key":"B","text":"疲劳驾驶"},{"key":"C","text":"超速行驶"},{"key":"D","text":"违规载人"}],"answer":"ABCD"},{"type":"判断题","stem":"持有《特种设备作业人员证》的人员，必须经用人单位的法定代表人（负责人）或者其授权人雇（聘）用后，方可在许可的项目范围内作业。","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"多选题","stem":"下列属于实心胎优点的是：（）","options":[{"key":"A","text":"耐磨性"},{"key":"B","text":"耐刺扎性"},{"key":"C","text":"安全性"},{"key":"D","text":"耐久性"}],"answer":"ABCD"},{"type":"单选题","stem":"叉车起升系统应当设置（）装置，避免货叉架和门架上的运动部件从门架上端意外脱落。","options":[{"key":"A","text":"限速"},{"key":"B","text":"限高"},{"key":"C","text":"防越程"},{"key":"D","text":"防脱落"}],"answer":"C"},{"type":"单选题","stem":"万向传动装置的作用是将变速器输出的动力顺利地传给（）","options":[{"key":"A","text":"发动机"},{"key":"B","text":"驱动桥"},{"key":"C","text":"转向桥"},{"key":"D","text":"车架"}],"answer":"B"},{"type":"多选题","stem":"场车的日常维护保养、自行检查由使用单位的场车()人员实施，全面检查由使用单位的场车()人员负责组织实施，或者委托其他专业机构实施。","options":[{"key":"A","text":"作业"},{"key":"B","text":"维修"},{"key":"C","text":"安全管理"},{"key":"D","text":"4S店维修"}],"answer":"AB"},{"type":"多选题","stem":"申请《特种设备作业人员证》的人员应当符合下列条件：","options":[{"key":"A","text":"年龄在 18 周岁以上；"},{"key":"B","text":"身体健康并满足申请从事的作业种类对身体的特殊要求；"},{"key":"C","text":"有与申请作业种类相适应的文化程度；"},{"key":"D","text":"有与申请作业种类相应的安全技术知识与技能；"}],"answer":"ABCD"},{"type":"判断题","stem":"清洗发动机时，必须切断电瓶线路。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"单选题","stem":"按总局140号令规定，《特种设备作业人员证》每（）复审一次","options":[{"key":"A","text":"1年"},{"key":"B","text":"2年"},{"key":"C","text":"3年"},{"key":"D","text":"4年"}],"answer":"D"},{"type":"单选题","stem":"制动踏板的自由行程应在（）范围","options":[{"key":"A","text":"30毫米"},{"key":"B","text":"40毫米"},{"key":"C","text":"各车型规定"},{"key":"D","text":"50毫米"}],"answer":"C"},{"type":"单选题","stem":"在TSG81-2022《场（厂）内专用机动车辆安全技术规程》规定，10%<观光车最大行驶坡度≤15%时，最大运行速度≤（）km/h。","options":[{"key":"A","text":"30"},{"key":"B","text":"25"},{"key":"C","text":"15"},{"key":"D","text":"20"}],"answer":"A"},{"type":"判断题","stem":"叉车制动系统经常出现制动失灵、制动效果不良、制动跑偏和制动拖滞等4种故障。","options":[{"key":"正确","text":"正确"},{"key":"错误","text":"错误"}],"answer":"正确"},{"type":"单选题","stem":"转向器松动会导致（）。","options":[],"answer":""},{"type":"单选题","stem":"机动车的制动性能是指车辆在最短的时间内或距离内（）的效能","options":[{"key":"A","text":"立即生效"},{"key":"B","text":"强制停车"},{"key":"C","text":"采取措施"},{"key":"D","text":"减速"}],"answer":"B"},{"type":"单选题","stem":"叉车在斜坡上载货行使，需要货叉向前行使上坡，倒退行使下坡。这样重心落在（）上，任何情况下都不允许在斜坡上掉头","options":[{"key":"A","text":"前叉"},{"key":"B","text":"货架"},{"key":"C","text":"前轮"},{"key":"D","text":"后轮"}],"answer":"C"},{"type":"单选题","stem":"场内机动车停放时，应关闭电门切断电源，拉紧（）并在规定位置停放。","options":[{"key":"A","text":"变速杆"},{"key":"B","text":"离合器"},{"key":"C","text":"制动器"},{"key":"D","text":"手制动器"}],"answer":"D"},{"type":"单选题","stem":"机动车的稳定性能是指（）抵抗侧滑和倾覆的能力。","options":[{"key":"A","text":"轿车"},{"key":"B","text":"汽车"},{"key":"C","text":"车辆"},{"key":"D","text":"叉车"}],"answer":"C"},{"type":"单选题","stem":"驱动桥的作用是（）。","options":[],"answer":""},{"type":"判断题","stem":"叉车制动系统经常出现制动失灵、制动效果不良、制动跑偏和制动拖滞等 4 种故障（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"车辆装运易燃、易爆、剧毒等危险物时，通过无人看守道口时，如视距达到规定要求，应做到“一慢、二看、三通过”；如达不到要求，必须做到“一停、二看、三通过”。()","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"A"},{"type":"判断题","stem":"机动车行驶：机动车在无限速标志的厂内主干道行驶时，不得超过 30km/h，其它道路不得超过 40km/h。()","options":[{"key":"A","text":"错误"},{"key":"B","text":"正确"}],"answer":"A"},{"type":"判断题","stem":"《场（厂）内专用机动车辆安全技术规程》规定。日常维护保养、自行检查和全面检查记录至少保存5年（）。","options":[],"answer":"正确"},{"type":"多选题","stem":"叉车车辆作业前应检查（）等装置是否灵敏可靠，严禁带病出车。","options":[{"key":"A","text":"刹车"},{"key":"B","text":"方向盘"},{"key":"C","text":"喇叭"},{"key":"D","text":"照明"}],"answer":"ABCD"},{"type":"单选题","stem":"叉车柴油发动机的起动电动机的蓄电池电压一般为（）","options":[{"key":"A","text":"12V"},{"key":"B","text":"24V"},{"key":"C","text":"36V"},{"key":"D","text":"48V"}],"answer":"B"},{"type":"判断题","stem":"维护车辆过程中，偶尔可以用活扳手代替锤子进行敲打作业（）","options":[{"key":"A","text":"正确"},{"key":"B","text":"错误"}],"answer":"错误"},{"type":"单选题","stem":"设备维修保养制度制定的意义是（）。","options":[{"key":"A","text":"发现起重机械制造时缺陷"},{"key":"B","text":"主要是解决起重机械安装时的一些缺陷"},{"key":"C","text":"提高设备的完好率"},{"key":"D","text":"有效地防止违章操作"}],"answer":"C"},{"type":"单选题","stem":"按照《特种设备安全监察条例》的规定，特种设备事故分为（）","options":[{"key":"A","text":"特别重大事故、重大事故、较大事故和一般事故"},{"key":"B","text":"特别重大事故、重大事故、严重事故和一般事故"},{"key":"C","text":"特别重大事故、重大事故、一般事故和轻微事故"},{"key":"D","text":"特别重大事故、较大事故、一般事故和轻微事故"}],"answer":"A"},{"type":"多选题","stem":"《特种设备安全监察条例》所称特种设备包含以下哪些设备（）","opti